# Homebrew formulae required by the exe.dev profile.
# Base-image commands (jq, ripgrep, tree, lsof, and opencode) are intentionally omitted.

brew "zsh"
brew "stow"
brew "starship"
brew "eza"
brew "bat"
brew "fzf"
brew "fd"
brew "zoxide"
brew "git-delta"
brew "procs"
tap "dlvhdr/formulae", trusted: true
brew "diffnav"
brew "gum"
brew "glow"
brew "rtk"
brew "hunk"
brew "television"
tap "Giammarco-Ferranti/deja", trusted: true
brew "deja"
