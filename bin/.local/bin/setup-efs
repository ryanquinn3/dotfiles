#!/usr/bin/env bash
 # Creates ~/X → ~/efs/X symlinks for persistent state across devcontainers.
 # Safe to re-run: skips already-correct symlinks, migrates real dirs/files to efs first.

 EFS_DIR="$HOME/efs"

 if [ ! -d "$EFS_DIR" ]; then
   echo "setup-efs: ~/efs not found, skipping"
   exit 0
 fi

 status_file="$(mktemp "${TMPDIR:-/tmp}/setup-efs.XXXXXX")"
 trap 'rm -f "$status_file"' EXIT

 link_to_efs() {
   local name="$1"
   local src="$HOME/$name"
   local dst="$EFS_DIR/$name"

   # Already correct
   if [ -L "$src" ] && [ "$(readlink "$src")" = "$dst" ]; then
     printf 'unchanged\t%s\n' "$name" >> "$status_file"
     return
   fi

   local migrated=false

   # Migrate real file/dir to efs if dst doesn't exist yet
   if [ ! -e "$dst" ] && [ -e "$src" ] && [ ! -L "$src" ]; then
     mv "$src" "$dst"
     migrated=true
   fi

   # Remove stale real file/dir at src
   if [ -e "$src" ] && [ ! -L "$src" ]; then
     rm -rf "$src"
   fi

   # Remove wrong symlink
   [ -L "$src" ] && rm "$src"

   mkdir -p "$(dirname "$src")"
   ln -s "$dst" "$src"

   if "$migrated"; then
     printf 'migrated\t%s\n' "$name" >> "$status_file"
   else
     printf 'linked\t%s\n' "$name" >> "$status_file"
   fi
 }

# Pi keeps its downloaded npm packages under .pi/agent/npm. Keep that one
# directory local (and move it back out of EFS if an older run linked all of
# .pi), while linking every other immediate Pi and agent entry to EFS.
link_pi_to_efs() {
  local pi_src="$HOME/.pi"
  local pi_dst="$EFS_DIR/.pi"
  local agent_src="$pi_src/agent"
  local agent_dst="$pi_dst/agent"
  local npm_src="$agent_src/npm"
  local npm_dst="$agent_dst/npm"
  local path name seen

  # Unfold a previous ~/.pi -> ~/efs/.pi link without touching its EFS data.
  [ -L "$pi_src" ] && rm "$pi_src"
  mkdir -p "$pi_src" "$pi_dst"

  # A real agent dir is required to make npm a local exception.
  [ -L "$agent_src" ] && rm "$agent_src"
  mkdir -p "$agent_src" "$agent_dst"

  # Iterate both locations so this works for both a fresh setup and an
  # existing full .pi symlink. Avoid processing an entry twice.
  seen='|'
  shopt -s nullglob dotglob
  for path in "$pi_src"/* "$pi_dst"/*; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    name="${path##*/}"
    [ "$name" = "agent" ] && continue
    [[ "$seen" == *"|$name|"* ]] && continue
    seen+="$name|"
    link_to_efs ".pi/$name"
  done

  seen='|'
  for path in "$agent_src"/* "$agent_dst"/*; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    name="${path##*/}"
    [ "$name" = "npm" ] && continue
    [[ "$seen" == *"|$name|"* ]] && continue
    seen+="$name|"
    link_to_efs ".pi/agent/$name"
  done
  shopt -u nullglob dotglob

  # Migrate npm packages out of EFS once, then leave future installs local.
  [ -L "$npm_src" ] && rm "$npm_src"
  if [ ! -e "$npm_src" ] && [ -e "$npm_dst" ]; then
    mv "$npm_dst" "$npm_src"
    printf 'local\t.pi/agent/npm\n' >> "$status_file"
  fi
 }
 
# symlink targets from home
dirs_to_link=()

# Credentials
dirs_to_link+=(".ssh" ".aws" ".awsvault" ".npmrc" ".terraform.d" ".config/gh")

# repo tools
dirs_to_link+=(
  ".claude/json"
  ".config/Code"
  ".config/lazydocker" 
  ".config/turborepo"
  ".config/acli"
  ".config/gsync"
  ".config/ddog"
  ".config/pup"
  ".cache/mcp2cli"
  ".cache/Homebrew"
  "ai-dev-archives"
  "tools"
)

# brew tools 
dirs_to_link+=(
  ".local/share/opencode"
  ".local/state/opencode"
  ".local/share/deja"
  ".local/state/glean-cli"
  ".codex"
  ".agents"
  ".plannotator"
  ".fx"
  ".ngrok2"
  ".semgrep"
  ".dotnet")

# shell tools
dirs_to_link+=(
  ".zsh_history"
  ".bun"
  ".local/share/zoxide")

# Keep the per-path work quiet: the spinner is the live progress indicator, and
# the final line is a compact summary.  Stderr is intentionally left visible so
# filesystem failures are not hidden.
export EFS_DIR status_file
export -f link_to_efs link_pi_to_efs
printf '%s\0' "${dirs_to_link[@]}" | gum spin \
  --spinner dot \
  --title "Syncing ${#dirs_to_link[@]} persistent paths to ~/efs..." \
  -- bash -c 'while IFS= read -r -d "" name; do link_to_efs "$name"; done; link_pi_to_efs'

migrated=$(grep -c '^migrated' "$status_file" || true)
linked=$(grep -c '^linked' "$status_file" || true)
unchanged=$(grep -c '^unchanged' "$status_file" || true)
local_only=$(grep -c '^local' "$status_file" || true)
summary="EFS ready: ${migrated} migrated, ${linked} linked, ${unchanged} already configured, ${local_only} kept local"

gum log --level info "$summary"
