#!/usr/bin/env bash
 # Creates ~/X → ~/efs/X symlinks for persistent state across devcontainers.
 # Safe to re-run: skips already-correct symlinks, migrates real dirs/files to efs first.

 EFS_DIR="$HOME/efs"

 if [ ! -d "$EFS_DIR" ]; then
   echo "setup-efs: ~/efs not found, skipping"
   exit 0
 fi

 link_to_efs() {
   local name="$1"
   local src="$HOME/$name"
   local dst="$EFS_DIR/$name"

   # Already correct
   if [ -L "$src" ] && [ "$(readlink "$src")" = "$dst" ]; then
     return
   fi

   # Migrate real file/dir to efs if dst doesn't exist yet
   if [ ! -e "$dst" ] && [ -e "$src" ] && [ ! -L "$src" ]; then
     mv "$src" "$dst"
   fi

   # Remove stale real file/dir at src
   if [ -e "$src" ] && [ ! -L "$src" ]; then
     rm -rf "$src"
   fi

   # Remove wrong symlink
   [ -L "$src" ] && rm "$src"

   mkdir -p "$(dirname "$src")"
   ln -s "$dst" "$src"
 }
 
# symlink targets from home
dirs_to_link=()

# Credentials
dirs_to_link+=(".ssh" ".aws" ".awsvault" ".npmrc" ".terraform.d" ".config/gh")

# repo tools
dirs_to_link+=(
  ".claude/json"
  ".config/Code"
  ".config/lazydocker" 
  ".config/turborepo"
  ".config/acli"
  ".config/gsync"
  ".config/ddog"
  ".config/pup"
  ".cache/mcp2cli"
  ".cache/Homebrew"
  "ai-dev-archives"
  "tools"
)

# brew tools 
dirs_to_link+=(
  ".local/share/opencode"
  ".local/state/opencode"
  ".local/share/deja"
  ".local/state/glean-cli"
  ".codex"
  ".fx"
  ".ngrok2"
  ".semgrep"
  ".dotnet")

# shell tools
dirs_to_link+=(
  ".zsh_history"
  ".bun"
  ".local/share/zoxide")

for dir in "${dirs_to_link[@]}"; do
  link_to_efs "$dir"
done
