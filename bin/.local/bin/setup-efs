#!/usr/bin/env bash
 # Creates ~/X → ~/efs/X symlinks for persistent state across devcontainers.
 # Safe to re-run: skips already-correct symlinks, migrates real dirs/files to efs first.

 EFS_DIR="$HOME/efs"

 if [ ! -d "$EFS_DIR" ]; then
   echo "setup-efs: ~/efs not found, skipping"
   exit 0
 fi

 status_file="$(mktemp "${TMPDIR:-/tmp}/setup-efs.XXXXXX")"
 trap 'rm -f "$status_file"' EXIT

 link_to_efs() {
   local name="$1"
   local src="$HOME/$name"
   local dst="$EFS_DIR/$name"

   # Already correct
   if [ -L "$src" ] && [ "$(readlink "$src")" = "$dst" ]; then
     printf 'unchanged\t%s\n' "$name" >> "$status_file"
     return
   fi

   local migrated=false

   # Migrate real file/dir to efs if dst doesn't exist yet
   if [ ! -e "$dst" ] && [ -e "$src" ] && [ ! -L "$src" ]; then
     mv "$src" "$dst"
     migrated=true
   fi

   # Remove stale real file/dir at src
   if [ -e "$src" ] && [ ! -L "$src" ]; then
     rm -rf "$src"
   fi

   # Remove wrong symlink
   [ -L "$src" ] && rm "$src"

   mkdir -p "$(dirname "$src")"
   ln -s "$dst" "$src"

   if "$migrated"; then
     printf 'migrated\t%s\n' "$name" >> "$status_file"
   else
     printf 'linked\t%s\n' "$name" >> "$status_file"
   fi
 }

# Keep selected entries local while linking all other immediate children of a
# directory to EFS. This also repairs an older run that folded the directory
# into a single EFS symlink.
keep_local() {
  local relative="$1"
  local src="$HOME/$relative"
  local dst="$EFS_DIR/$relative"

  [ -L "$src" ] && rm "$src"
  if [ ! -e "$src" ] && [ -e "$dst" ]; then
    mv "$dst" "$src"
    printf 'local\t%s\n' "$relative" >> "$status_file"
  fi
}

link_children_to_efs() {
  local relative="$1"
  shift
  local src="$HOME/$relative"
  local dst="$EFS_DIR/$relative"
  local path name seen excluded

  # Unfold a previous symlink, but leave its contents in EFS for migration
  # below. The destination must be real so local exceptions can live in it.
  [ -L "$src" ] && rm "$src"
  mkdir -p "$src" "$dst"

  for excluded in "$@"; do
    keep_local "$relative/$excluded"
  done

  seen='|'
  shopt -s nullglob dotglob
  for path in "$src"/* "$dst"/*; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    name="${path##*/}"
    [[ "$seen" == *"|$name|"* ]] && continue
    seen+="$name|"

    # Entries named on the function call are intentionally local.
    for excluded in "$@"; do
      [ "$name" = "$excluded" ] && continue 2
    done
    link_to_efs "$relative/$name"
  done
  shopt -u nullglob dotglob
}

# Pi's downloaded npm packages and git repository stay local; other Pi state
# is persistent across devcontainers.
link_pi_to_efs() {
  link_children_to_efs ".pi" agent
  link_children_to_efs ".pi/agent" npm git
}
 
# symlink targets from home
dirs_to_link=()

# Credentials
dirs_to_link+=(".ssh" ".aws" ".awsvault" ".npmrc" ".terraform.d" ".config/gh")

# repo tools
dirs_to_link+=(
  ".claude/json"
  ".config/Code"
  ".config/lazydocker" 
  ".config/turborepo"
  ".config/acli"
  ".config/gsync"
  ".config/ddog"
  ".config/pup"
  ".config/slack-vanta"
  ".cache/mcp2cli"
  ".cache/Homebrew"
  "ai-dev-archives"
  "tools"
)

# brew tools 
dirs_to_link+=(
  ".local/share/opencode"
  ".local/state/opencode"
  ".local/share/deja"
  ".local/state/glean-cli"
  ".codex"
  ".agents"
  ".plannotator"
  ".fx"
  ".ngrok2"
  ".semgrep"
  ".dotnet")

# shell tools
dirs_to_link+=(
  ".zsh_history"
  ".bun"
  ".local/share/zoxide")

# Keep the per-path work quiet: the spinner is the live progress indicator, and
# the final line is a compact summary.  Stderr is intentionally left visible so
# filesystem failures are not hidden.
export EFS_DIR status_file
export -f link_to_efs keep_local link_children_to_efs link_pi_to_efs
sync_paths() {
  local name
  while IFS= read -r -d '' name; do
    link_to_efs "$name"
  done
  link_pi_to_efs
}
export -f sync_paths

if command -v gum >/dev/null 2>&1; then
  printf '%s\0' "${dirs_to_link[@]}" | gum spin \
    --spinner dot \
    --title "Syncing ${#dirs_to_link[@]} persistent paths to ~/efs..." \
    -- bash -c 'sync_paths'
else
  echo "Syncing ${#dirs_to_link[@]} persistent paths to ~/efs..."
  printf '%s\0' "${dirs_to_link[@]}" | sync_paths
fi

migrated=$(grep -c '^migrated' "$status_file" || true)
linked=$(grep -c '^linked' "$status_file" || true)
unchanged=$(grep -c '^unchanged' "$status_file" || true)
local_only=$(grep -c '^local' "$status_file" || true)
summary="EFS ready: ${migrated} migrated, ${linked} linked, ${unchanged} already configured, ${local_only} kept local"

if [ command -v gum >/dev/null 2>&1 ]; then
  gum log --level info "$summary"
else
  echo "$summary"
fi
